{
  "name": "barebox",
  "version": "0.2.0",
  "description": "Lightweight local sandbox for AI agents: every write undoable, nothing leaves the machine without passing the doorman.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamr0/barebox.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./primitives.json": "./primitives.json"
  },
  "bin": {
    "sbx": "src/cli.js"
  },
  "files": [
    "src",
    "types",
    "primitives.json",
    "barebox.context.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "primitives": "./primitives.json",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "poc:m0": "bash poc/m0/run-m0.sh",
    "redteam:m0": "bash poc/m0/redteam.sh",
    "bench": "node scripts/bench.mjs",
    "test": "env -u NODE_USE_ENV_PROXY -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u FTP_PROXY -u http_proxy -u https_proxy -u all_proxy -u ftp_proxy node --test --import ./test/setup-env.mjs \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc",
    "build:primitives": "node scripts/gen-primitives.mjs",
    "check:primitives": "node scripts/gen-primitives.mjs --check",
    "prepack": "npm run build:types",
    "prepublishOnly": "npm run build:primitives && npm run build:types"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "5"
  }
}
